{
  "name": "easymeet",
  "version": "0.1.0",
  "description": "P2P video conferencing in the browser – chat, file sharing, screen sharing, virtual backgrounds",
  "author": "Patrick Weppelmann",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smotherer007/easymeet.git"
  },
  "homepage": "https://easymeet.easyroomtools.tech/",
  "bugs": {
    "url": "https://github.com/Smotherer007/easymeet/issues"
  },
  "keywords": [
    "video-conference",
    "webrtc",
    "peerjs",
    "p2p",
    "screen-sharing",
    "chat",
    "virtual-backgrounds",
    "videocall",
    "meeting"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "docker:build": "docker build --no-cache --platform linux/amd64 -t smotherer/easymeet:latest .",
    "docker:push": "docker push smotherer/easymeet:latest",
    "docker:build:and:push": "npm run docker:build && npm run docker:push"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@mediapipe/tasks-vision": "^0.10.32",
    "bcrypt": "^6.0.0",
    "fflate": "^0.8.2",
    "lucide": "^0.577.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "sdp-transform": "^3.0.0",
    "vite": "^7.3.1"
  }
}

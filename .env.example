# Easymeet – Beispiel für Docker Compose / docker run
# Kopieren: cp .env.example .env  und Werte anpassen.
# .env ist in .gitignore.

# --- HTTP ---
PORT=3001
NODE_ENV=production

# --- mediasoup / WebRTC ---
# In Docker/Cloud zwingend: öffentliche IPv4 oder erreichbarer Hostname (ICE)
MEDIASOUP_ANNOUNCED_IP=

# Bind im Container (Standard: alle Interfaces)
MEDIASOUP_LISTEN_IP=0.0.0.0

# UDP-Range (Standard 40000–40200) – bei Änderung auch docker-compose.yml Port-Zeile anpassen
RTC_MIN_PORT=40000
RTC_MAX_PORT=40200

# --- Feste Räume (JSON-Datei) ---
# Pfad relativ zum Arbeitsverzeichnis (lokal: Repo-Root; Docker: meist /app)
# Vorlage: cp config/persistent-rooms.example.json config/persistent-rooms.json
EASYMEET_PERSISTENT_ROOMS=config/persistent-rooms.json

# Passwort für STANDUP, falls in der JSON "passwordEnv" verwendet wird
# EASYMEET_ROOM_STANDUP_PASSWORD=geheim

# --- Optional ---
# TENOR_API_KEY=

# Easymeet template (server + Vite client, repo root)
#
# Copy: cp .env.example .env
# Vite reads the same .env (only variables with the VITE_* prefix).
#
# Docker Compose: env_file -> ./.env (see docker-compose.yml).

# --- HTTP (server) ---
PORT=3001
NODE_ENV=production

# --- mediasoup / WebRTC ---
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_LISTEN_IP=0.0.0.0
RTC_MIN_PORT=40000
RTC_MAX_PORT=40200

# --- Logging (server) ---
# EASYMEET_LOG_LEVEL=info
# SQLite path
# Local (recommended): EASYMEET_DB_PATH=data/easymeet.sqlite
# Docker (with volume): EASYMEET_DB_PATH=/app/data/easymeet.sqlite
# EASYMEET_DB_PATH=data/easymeet.sqlite

# --- Rate limits (server) ---
# Per-IP budgets; all counted over a 60s window. Defaults are fine for most setups.
# EASYMEET_API_RATE_LIMIT_MAX=120
# EASYMEET_JOIN_RATE_LIMIT_MAX=30
# Dedicated brute-force budget for the one-time admin bootstrap login. The token
# has plenty of entropy but no reason to allow mass guessing.
# EASYMEET_BOOTSTRAP_LOGIN_RATE_LIMIT_MAX=5

# --- CORS (server, comma-separated origins; leave unset for sensible dev defaults) ---
# EASYMEET_CORS_ORIGINS=https://meet.example.com,https://staging.meet.example.com

# --- Optional (server) ---
# Tenor v2 (Google Cloud) API key. Without this, /api/gifs returns empty results.
# Request at https://developers.google.com/tenor/guides/quickstart
# TENOR_API_KEY=

# --- Client (Vite, build time - no secrets) ---
# silent | error | warn | info | debug
# VITE_LOG_LEVEL=info
# VITE_PROXY_API_TARGET=http://localhost:3001
# VITE_MEDIASOUP_PROTOO_DIRECT=false
# VITE_MEDIASOUP_PROTOO_PORT=3001

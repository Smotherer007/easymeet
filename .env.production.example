# EasyMeet – Beispiel für Produktion (Docker / Server)
# Kopieren: cp .env.production.example .env  und Werte setzen.
# Nicht committen: .env bleibt in .gitignore.

# --- HTTP (im Container) ---
PORT=3001
NODE_ENV=production

# --- mediasoup / WebRTC (Pflicht für Zugriff von außen) ---
# Öffentliche IPv4 oder DNS-Name, den Clients für ICE nutzen (gleicher Host wie die Web-URL oder eure öffentliche IP)
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Im Container meist:
MEDIASOUP_LISTEN_IP=0.0.0.0

# UDP-Range – muss zu Firewall/Host-Routing und ggf. Docker passen
RTC_MIN_PORT=40000
RTC_MAX_PORT=40200

# --- Feste Räume ---
# Pfad im Container (oft mit Volume gemountet)
EASYMEET_PERSISTENT_ROOMS=/app/config/persistent-rooms.json

# Falls in persistent-rooms.json "passwordEnv" verwendet wird:
# EASYMEET_ROOM_STANDUP_PASSWORD=…

# --- Optional ---
# TENOR_API_KEY=

# --- Nur wenn du das Frontend auf derselben Maschine baust (Vite) ---
# Normalerweise leer: Protoo nutzt dann die Seiten-Origin (443).
# VITE_MEDIASOUP_PROTOO_DIRECT=true
# VITE_MEDIASOUP_PROTOO_PORT=3001

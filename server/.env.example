# Easymeet API + mediasoup — optionale lokale Overrides
#
# Standard: Repo-Root `.env` (Vorlage: .env.example).
# Einträge hier überschreiben gleichnamige Variablen aus der Root-.env.

# --- HTTP ---
# PORT=3001
# NODE_ENV=development

# --- mediasoup ---
# MEDIASOUP_ANNOUNCED_IP=
# MEDIASOUP_LISTEN_IP=0.0.0.0
# RTC_MIN_PORT=40000
# RTC_MAX_PORT=40200

# --- Feste Räume (Pfad relativ zum Repo-Root) ---
# EASYMEET_PERSISTENT_ROOMS=persistent-rooms.json

# EASYMEET_LOG_LEVEL=info
# TENOR_API_KEY=

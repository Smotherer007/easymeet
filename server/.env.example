# Easymeet template (server + Vite client, repo root)
#
# Copy: cp .env.example .env
# Vite reads the same .env (only variables with the VITE_* prefix).
#
# Docker Compose: env_file -> ./.env (see docker-compose.yml).

# --- HTTP (server) ---
PORT=3001
NODE_ENV=production
# Comma-separated allowlist (for example: https://meet.example.com,https://app.example.com)
# EASYMEET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Global per-minute limit for /api/*
# EASYMEET_API_RATE_LIMIT_MAX=120
# Per-minute limit specifically for /api/join
# EASYMEET_JOIN_RATE_LIMIT_MAX=30

# --- mediasoup / WebRTC ---
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_LISTEN_IP=0.0.0.0
RTC_MIN_PORT=40000
RTC_MAX_PORT=40200

# --- Logging (server) ---
# EASYMEET_LOG_LEVEL=info
# SQLite path
# Local: EASYMEET_DB_PATH=data/easymeet.sqlite
# Docker (Volume): EASYMEET_DB_PATH=/app/data/easymeet.sqlite
# EASYMEET_DB_PATH=data/easymeet.sqlite
# Per 10 seconds and peer (WebSocket notifications)
# EASYMEET_WS_CHAT_PER_10S=20
# EASYMEET_WS_FILE_CHUNKS_PER_10S=160

# --- Optional (server) ---
# GIF picker: Giphy API key (Beta key: free, rate-limited 100 req/h).
# Obtain at https://developers.giphy.com/ → "Create an App".
# Served to the browser at runtime via /api/runtime-config.json — not baked
# into the client bundle, so key changes don't require an image rebuild.
# GIPHY_API_KEY=

# --- Client (Vite, build time - no secrets) ---
# silent | error | warn | info | debug
# VITE_LOG_LEVEL=info
# VITE_PROXY_API_TARGET=http://localhost:3001
# VITE_MEDIASOUP_PROTOO_DIRECT=false
# VITE_MEDIASOUP_PROTOO_PORT=3001

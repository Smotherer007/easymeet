# Easymeet – Vorlage (Server + Vite-Client, Repo-Root)
#
# Kopie: cp .env.example .env
# Feste Räume: cp persistent-rooms.example.json persistent-rooms.json
#
# Vite liest dieselbe .env (nur Variablen mit Präfix VITE_*).
#
# Docker Compose: env_file → ./.env (siehe docker-compose.yml).
# Feste Räume ohne Volume (empfohlen für Compose): eine Zeile JSON:
# EASYMEET_PERSISTENT_ROOMS_JSON='{"rooms":[{"id":"LOBBY"}]}'
# Oder persistent-rooms.json + volumes:-Block in docker-compose.yml aktivieren.

# --- HTTP (Server) ---
PORT=3001
NODE_ENV=production

# --- mediasoup / WebRTC ---
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_LISTEN_IP=0.0.0.0
RTC_MIN_PORT=40000
RTC_MAX_PORT=40200

# --- Feste Räume (JSON) — Pfad relativ zum Repo-Root (lokal + Container /app) ---
EASYMEET_PERSISTENT_ROOMS=persistent-rooms.json

# Passwort für feste Räume mit "passwordEnv" in der JSON
# EASYMEET_ROOM_STANDUP_PASSWORD=geheim

# --- Logging (Server) ---
# EASYMEET_LOG_LEVEL=info

# --- Optional (Server) ---
# TENOR_API_KEY=

# --- Client (Vite, Build-Zeit — keine Geheimnisse) ---
# silent | error | warn | info | debug
# VITE_LOG_LEVEL=info
# VITE_PROXY_API_TARGET=http://localhost:3001
# VITE_MEDIASOUP_PROTOO_DIRECT=false
# VITE_MEDIASOUP_PROTOO_PORT=3001
